{
  "Jwt": {
    "Issuer": "ATSolution",
    "Audience": "ATSolution.Client",
    "Key": "ATSolution-Dev-Signing-Key-Change-In-Production-Min32Chars!",
    "ExpirationMinutes": 480
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "http://localhost:4173"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SqlConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=ATSolutionDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Seeding": {
    "SeedMockData": true,
    "ForceReseed": false,
    "AllowManualSeed": true
  }
}
